# ============================================================================
# NUGASIN — FIREBASE CLIENT & ADMIN SDK ENVIRONMENT VARIABLES
# Copy this file to .env for local development, or add these variables in
# Vercel Dashboard -> Project Settings -> Environment Variables
# ============================================================================

# 1. Public Firebase Web Client SDK Config (Safe for client via /api/firebase-config)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id

# 2. Private Firebase Admin SDK Credentials (SERVER-ONLY — NEVER EXPOSE TO CLIENT)
# Use credentials from the SAME existing Firebase project as the web config.
# Never paste these Admin fields into Nugasin's runtime web-config editor.
# XP endpoints fail closed (503) until Admin credentials are configured.
# Option A: Full Service Account JSON string (single line)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com"}

# Option B: Individual Service Account fields
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
